# ============================================================================
# Backend Environment Variables
# Copy this to .env and fill in your actual values:
#   cp .env.example .env && nano .env
# ============================================================================

# --- PostgreSQL ---
PG_HOST=postgres-postgresql.default.svc.cluster.local
PG_PORT=5432
PG_DB=ml_platform
PG_USER=postgres
PG_PASSWORD=CHANGE_ME

# --- Git Repository ---
# Absolute path to the cloned k8s-manifests repo inside the container
GIT_REPO_PATH=/app/repo
# GitHub Personal Access Token with repo scope
GIT_TOKEN=CHANGE_ME
# Full repo URL (the token gets embedded at runtime for auth)
GIT_REPO_URL=https://github.com/YOUR_USERNAME/foundational-model-hosting-platform.git
GIT_USERNAME=YOUR_USERNAME

# --- ArgoCD ---
# Internal K8s service URL for ArgoCD
ARGOCD_URL=https://argocd-server.argocd.svc.cluster.local:443
# Bearer token generated in ArgoCD UI → Settings → Accounts → admin → Tokens
ARGOCD_TOKEN=CHANGE_ME
# ArgoCD Application name (must match the name in ml-platform-app.yaml)
ARGOCD_APP_NAME=ml-platform

# --- Cluster ---
# The IP that NodePorts are accessible on (usually the worker node IP)
CLUSTER_IP=172.25.2.52
# Path to kubeconfig file (for querying pod status and NodePorts)
KUBECONFIG=/app/kubeconfig

# --- Server ---
PORT=3001
